<!DOCTYPE html>
<html>
<head>
  <title>Task Manager — Turbo Desktop Example</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag "application" %>
  <%= javascript_importmap_tags %>

  <%# Enables the Turbo Desktop Dev Inspector (dev only) and points the shell at
      the gem-served inspector assets. No-op in production / plain browsers. %>
  <%= turbo_desktop_inspector_meta_tag %>
</head>
<%# A page shown in a modal has a window of its own around it: the
    navigation and the footer belong to the main window. %>
<body class="<%= "in-modal" if in_a_modal? %>">
  <% unless in_a_modal? %>
  <nav class="navbar">
    <div class="container">
      <div class="navbar-brand">
        <%= link_to root_path, class: "navbar-logo" do %>
          <span class="logo-icon">&#9745;</span>
          <span>Task Manager</span>
        <% end %>
      </div>
      <div class="navbar-links">
        <%= link_to "Dashboard", root_path, class: "nav-link" %>
        <%= link_to "Tasks", tasks_path, class: "nav-link" %>
        <%# Only in the desktop app: the scenarios need the shell. %>
        <%= turbo_desktop_only do %>
          <%= link_to "Checks", checks_path, class: "nav-link" %>
        <% end %>
      </div>

      <%# Where the request came from: the desktop shell, and which, or a
          browser. Opens to show the rest. %>
      <%= render "shared/origin" %>

      <%# The dock icon's badge is the number of tasks still to do. The element
          declares the component; the shell's script sets the badge from it. %>
      <%= turbo_desktop_only do %>
        <%= tag.span hidden: true, **turbo_desktop_bridge("badge", count: Task.pending.count) %>
      <% end %>
    </div>
  </nav>
  <% end %>

  <main class="container">
    <% if notice.present? %>
      <div class="flash flash-notice"><%= notice %></div>
    <% end %>
    <% if alert.present? %>
      <div class="flash flash-alert"><%= alert %></div>
    <% end %>

    <%= yield %>
  </main>

  <% unless in_a_modal? %>
  <footer class="container footer">
    <p>
      Built with
      <a href="https://github.com/aguspe/turbo_desktop">Turbo Desktop</a>,
      <a href="https://rubyonrails.org">Rails</a>, and
      <a href="https://tauri.app">Tauri</a>.
    </p>
  </footer>
  <% end %>
</body>
</html>
