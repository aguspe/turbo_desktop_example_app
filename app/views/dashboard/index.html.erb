<div class="dashboard">
  <h1>Dashboard</h1>

  <div class="stats-grid">
    <div class="stat-card">
      <div class="stat-number"><%= @total_tasks %></div>
      <div class="stat-label">Total Tasks</div>
    </div>
    <div class="stat-card stat-completed">
      <div class="stat-number"><%= @completed_tasks %></div>
      <div class="stat-label">Completed</div>
    </div>
    <div class="stat-card stat-pending">
      <div class="stat-number"><%= @pending_tasks %></div>
      <div class="stat-label">Pending</div>
    </div>
  </div>

  <%# Desktop-only section: shows native feature tips %>
  <%= turbo_desktop_only do %>
    <div class="desktop-features-banner"
         data-controller="import"
         data-action="turbo-desktop:drop@document->import#filesDropped
                      turbo-desktop:file-open@document->import#filesDropped
                      turbo-desktop:drag-enter@document->import#highlight
                      turbo-desktop:drag-leave@document->import#unhighlight">
      <h3>Desktop Features Active</h3>
      <p>
        You're running in Turbo Desktop. Try the native side of this app:
      </p>
      <ul class="desktop-feature-list">
        <li><strong>Drop a .csv anywhere on this window</strong> to import tasks
            &mdash; the page receives the real file path.</li>
        <li>Open a .csv <em>with</em> this app (or drop it on the dock icon) and
            it imports the same way, even from a cold start.</li>
        <li>Create a task &mdash; it opens in a native modal window.</li>
        <li>Complete a task &mdash; a native notification fires.</li>
      </ul>

      <div class="desktop-feature-actions">
        <button class="btn btn-secondary"
                data-controller="clipboard"
                data-action="clipboard#pasteAsTask">
          New task from clipboard
        </button>

        <%# DOOM as WebAssembly from public/doom/ — the path configuration
            routes /doom to its own native window. %>
        <%= link_to "Play DOOM", "/doom/index.html", class: "btn btn-secondary" %>

        <label class="autostart-toggle" data-controller="autostart">
          <input type="checkbox"
                 data-autostart-target="checkbox"
                 data-action="autostart#toggle">
          Start Task Manager when I log in
        </label>
      </div>
    </div>
  <% end %>

  <%# Web-only section: encourage desktop download %>
  <%= turbo_web_only do %>
    <div class="web-banner">
      <h3>Try the Desktop App</h3>
      <p>
        This app also runs as a native desktop application using
        <a href="https://github.com/aguspe/turbo_desktop">Turbo Desktop</a>.
        Get native notifications, modal windows, and more!
      </p>
    </div>
  <% end %>

  <div class="recent-tasks">
    <div class="section-header">
      <h2>Recent Tasks</h2>
      <%= link_to "View All", tasks_path, class: "btn btn-secondary" %>
    </div>

    <% @recent_tasks.each do |task| %>
      <div class="task-row">
        <div class="task-status">
          <% if task.completed? %>
            <span class="status-icon completed">&#10003;</span>
          <% else %>
            <span class="status-icon pending">&#9675;</span>
          <% end %>
        </div>
        <div class="task-info">
          <%= link_to task.title, task_path(task) %>
          <span class="priority-badge priority-<%= task.priority %>"><%= task.priority %></span>
        </div>
      </div>
    <% end %>
  </div>
</div>
