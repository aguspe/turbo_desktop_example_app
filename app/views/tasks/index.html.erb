<div class="tasks-page"
     data-controller="import"
     data-action="turbo-desktop:drop@document->import#filesDropped
                  turbo-desktop:file-open@document->import#filesDropped
                  turbo-desktop:drag-enter@document->import#highlight
                  turbo-desktop:drag-leave@document->import#unhighlight">
  <div class="section-header">
    <h1>Tasks</h1>
    <div class="section-actions">
      <%# Desktop only: native save dialog → CSV written wherever the user
          points it, no filesystem roots needed — the pick is the consent. %>
      <%= turbo_desktop_only do %>
        <button class="btn btn-secondary"
                data-controller="export"
                data-action="export#save">
          Export CSV&hellip;
        </button>
      <% end %>
      <%# This link goes to /tasks/new, which matches the "/new$" path rule.
          In the desktop shell, it opens as a native modal window.
          In a regular browser, it navigates normally. %>
      <%= link_to "New Task", new_task_path, class: "btn btn-primary" %>
    </div>
  </div>

  <div class="task-list">
    <% @tasks.each do |task| %>
      <div class="task-card" id="<%= dom_id(task) %>">
        <div class="task-card-header">
          <div class="task-status">
            <% if task.completed? %>
              <span class="status-icon completed" title="Completed">&#10003;</span>
            <% else %>
              <span class="status-icon pending" title="Pending">&#9675;</span>
            <% end %>
          </div>
          <div class="task-title">
            <%= link_to task.title, task_path(task) %>
          </div>
          <span class="priority-badge priority-<%= task.priority %>"><%= task.priority %></span>
        </div>

        <% if task.description.present? %>
          <p class="task-description"><%= truncate(task.description, length: 120) %></p>
        <% end %>

        <div class="task-actions">
          <%# This link goes to /tasks/:id/edit, which matches "/edit$".
              In the desktop shell, it opens as a modal. %>
          <%= link_to "Edit", edit_task_path(task), class: "btn btn-sm btn-secondary" %>

          <% unless task.completed? %>
            <%# Mark as complete. In the desktop app a notification says so:
                the button declares the component, and the shell's script
                shows it when the button is pressed. %>
            <%= button_to "Complete", task_path(task),
                  method: :patch,
                  params: { task: { completed: true } },
                  class: "btn btn-sm btn-success",
                  # Among the button's own attributes, not inside data: { },
                  # which would prefix the names a second time.
                  **turbo_desktop_bridge("notification",
                    title: "Task completed",
                    body: task.title
                  ) %>
          <% end %>

          <%= button_to "Delete", task_path(task),
                method: :delete,
                class: "btn btn-sm btn-danger",
                data: { turbo_confirm: "Are you sure?" } %>
        </div>
      </div>
    <% end %>

    <% if @tasks.empty? %>
      <div class="empty-state">
        <p>No tasks yet. Create your first task!</p>
        <%= link_to "New Task", new_task_path, class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>
</div>
