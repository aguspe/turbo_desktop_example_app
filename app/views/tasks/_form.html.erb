<%# This form partial is shared by new.html.erb and edit.html.erb.
    When accessed via /tasks/new or /tasks/:id/edit, the desktop shell
    opens this page in a native modal window (configured in turbo_desktop.rb). %>

<%= form_with(model: task, class: "task-form") do |form| %>
  <% if task.errors.any? %>
    <div class="form-errors">
      <h3><%= pluralize(task.errors.count, "error") %> prevented this task from being saved:</h3>
      <ul>
        <% task.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= form.label :title, class: "form-label" %>
    <%= form.text_field :title, class: "form-input", placeholder: "What needs to be done?", autofocus: true %>
  </div>

  <div class="form-group">
    <%= form.label :description, class: "form-label" %>
    <%= form.text_area :description, class: "form-input form-textarea", placeholder: "Add details...", rows: 4 %>
  </div>

  <div class="form-group">
    <%= form.label :priority, class: "form-label" %>
    <%= form.select :priority, [["Low", "low"], ["Medium", "medium"], ["High", "high"]], {}, class: "form-input" %>
  </div>

  <div class="form-group">
    <%= form.label :completed, class: "form-label" do %>
      <%= form.check_box :completed, class: "form-checkbox" %>
      Mark as completed
    <% end %>
  </div>

  <div class="form-actions">
    <%= form.submit class: "btn btn-primary" %>
    <%= link_to "Cancel", tasks_path, class: "btn btn-secondary" %>
  </div>
<% end %>
