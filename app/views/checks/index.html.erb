<%# Scenarios that involve the operating system, to go through by hand.
    Each card marks itself when the app sees the thing happen. %>
<div class="checks"
     data-controller="checks"
     data-checks-deep-link-value="<%= @deep_link %>"
     data-action="turbo-desktop:drop@document->checks#dropped
                  turbo-desktop:drag-enter@document->checks#dragEntered
                  turbo-desktop:drag-leave@document->checks#dragLeft
                  turbo-desktop:file-open@document->checks#fileOpened
                  turbo-desktop:focus@document->checks#cameBack">

  <div class="section-header">
    <h1>Desktop checks</h1>
    <div class="section-actions">
      <span class="check-tally" data-checks-target="tally"></span>
      <button class="btn btn-primary" data-action="checks#runAll">Run the automatic ones</button>
      <button class="btn btn-secondary" data-action="checks#startOver">Start over</button>
    </div>
  </div>

  <%= turbo_web_only do %>
    <div class="web-banner">
      These scenarios need the desktop app. Open this page there, from the Checks link.
    </div>
  <% end %>

  <p class="check-intro">
    Fifteen scenarios that no automated test can reach, because they involve the operating
    system itself. Each says what to do and what to expect, and marks itself when the app
    sees it happen. The ones you judge by eye have a button for what you saw.
  </p>

  <h2 class="check-group">The shell does these when asked</h2>

  <%= render "check", id: "shell", title: "The app knows where it is running",
        steps: [ "Press Run." ],
        expect: "The shell's version, this platform, and the window's label." do %>
    <button class="btn btn-sm btn-secondary" data-action="checks#whereAmI">Run</button>
  <% end %>

  <%= render "check", id: "notification", title: "A notification appears",
        steps: [ "Press Send.",
                 "The first time, the system asks whether the app may send notifications. Allow it.",
                 "Say whether you saw it." ],
        expect: "A notification titled \"Task Manager\" in the corner of the screen and in the notification centre." do %>
    <button class="btn btn-sm btn-secondary" data-action="checks#notify">Send</button>
    <%= render "verdict", id: "notification" %>
  <% end %>

  <%= render "check", id: "badge", title: "The dock icon shows a count",
        steps: [ "Press Set to 3 and look at the app's icon in the dock or taskbar.",
                 "Press Clear and look again.",
                 "Say whether you saw both." ],
        expect: "A red 3 on the icon, then nothing." do %>
    <button class="btn btn-sm btn-secondary" data-action="checks#badge" data-count="3">Set to 3</button>
    <button class="btn btn-sm btn-secondary" data-action="checks#badge" data-count="0">Clear</button>
    <%= render "verdict", id: "badge" %>
  <% end %>

  <%= render "check", id: "menu-item", title: "A menu item the page added",
        steps: [ "Press Add.",
                 "Open the Actions menu in the menu bar and choose \"Mark this check done\".",
                 "Or press its shortcut, Cmd/Ctrl+Shift+M." ],
        expect: "An Actions menu with the item in it. Choosing it marks this card." do %>
    <button class="btn btn-sm btn-secondary" data-action="checks#addMenuItem">Add</button>
    <button class="btn btn-sm btn-secondary" data-action="checks#removeMenuItem">Remove</button>
  <% end %>

  <%= render "check", id: "shortcut", title: "A shortcut that works from anywhere",
        steps: [ "Press Register.",
                 "Switch to another application, so this one is in the background.",
                 "Press Cmd/Ctrl+Shift+K.",
                 "Come back." ],
        expect: "This card is marked, although the app was not in front when you pressed it." do %>
    <button class="btn btn-sm btn-secondary" data-action="checks#registerShortcut">Register</button>
    <button class="btn btn-sm btn-secondary" data-action="checks#unregisterShortcut">Unregister</button>
  <% end %>

  <%= render "check", id: "clipboard", title: "The clipboard, without a click",
        steps: [ "Press Run.", "Paste into any other application." ],
        expect: "The text written is read back, and pastes elsewhere as \"Turbo Desktop check\"." do %>
    <button class="btn btn-sm btn-secondary" data-action="checks#clipboard">Run</button>
  <% end %>

  <h2 class="check-group">Files</h2>

  <%= render "check", id: "drop", title: "A file dragged from the desktop",
        steps: [ "Drag any file from the Finder or Explorer onto this window.",
                 "Then drag a folder." ],
        expect: "The window highlights as you drag over it. The file's real path appears here, with its size, read through the filesystem bridge." do %>
  <% end %>

  <%= render "check", id: "file-open", title: "A file opened with the app",
        steps: [ "Build the app: bin/demo-package, then open the built app.",
                 "In the Finder, right-click a .csv file, Open With, Task Manager.",
                 "Quit the app and do it again, so the double-click is what starts it." ],
        expect: "The app comes forward with the file's path here, both times. Its tasks are imported." do %>
  <% end %>

  <h2 class="check-group">Links and windows</h2>


  <%= render "check", id: "deep-link", title: "A link from outside the app",
        arrived: @arrived_by_deep_link,
        steps: [ "Build the app: bin/demo-package, and open the built app once, so the system learns its scheme.",
                 "Press Copy, and run what it copied in a terminal.",
                 "On Windows, paste the link itself into the Run dialog." ],
        expect: "The app comes forward on this page, and this card is marked." do %>
    <button class="btn btn-sm btn-secondary" data-action="checks#copyDeepLink">Copy</button>
    <code class="check-code"><%= "open \"#{@deep_link}\"" %></code>
  <% end %>

  <%= render "check", id: "modal", title: "A form in a window of its own",
        steps: [ "Press New task.",
                 "Look at this window behind the one that opened.",
                 "Save the task, or close the window." ],
        expect: "A separate, smaller window with the form. This window stays on this page, and is still here when the other one closes." do %>
    <%= link_to "New task", new_task_path, class: "btn btn-sm btn-secondary", data: { action: "checks#modalOpened" } %>
    <%= render "verdict", id: "modal" %>
  <% end %>

  <%= render "check", id: "external-link", title: "A link to somewhere else",
        steps: [ "Press the link." ],
        expect: "It opens in your browser. This window stays where it is." do %>
    <a class="btn btn-sm btn-secondary" href="https://turbo-desktop.dev/" data-action="checks#externalFollowed">turbo-desktop.dev</a>
    <%= render "verdict", id: "external-link" %>
  <% end %>

  <%= render "check", id: "focus", title: "Coming back to the app",
        steps: [ "Switch to another application for a few seconds.", "Come back." ],
        expect: "How long you were away, in seconds." do %>
  <% end %>

  <h2 class="check-group">Opening and closing</h2>

  <%= render "check", id: "window-size", title: "The window opens at the size you left it",
        steps: [ "Resize the window to something you will recognise.",
                 "Quit the app and open it again.",
                 "Come back to this page." ],
        expect: "The size from last time and the size now are the same." do %>
    <button class="btn btn-sm btn-secondary" data-action="checks#rememberSize">Note the size now</button>
  <% end %>

  <%= render "check", id: "quit", title: "Quitting stops the server",
        steps: [ "Start the app with nothing running on its port, so that it starts the server.",
                 "Quit with Cmd+Q, or Alt+F4 on Windows.",
                 "In a terminal: lsof -nP -iTCP:3000 -sTCP:LISTEN (Windows: netstat -ano | findstr :3000)",
                 "Open the app again and say what you saw." ],
        expect: "Nothing is listening after the app has quit." do %>
    <%= render "verdict", id: "quit" %>
  <% end %>

  <%= render "check", id: "packaged", title: "The built app",
        steps: [ "Run bin/demo-package. It prints where the app is.",
                 "Quit this one, and open the built one from the Finder.",
                 "Come back to this page in it." ],
        expect: "The app opens and starts its server on its own. This card says it is running from a bundle." do %>
    <button class="btn btn-sm btn-secondary" data-action="checks#packaged">Check</button>
  <% end %>

  <h2 class="check-group">What happened</h2>
  <pre class="check-log" data-checks-target="log" aria-live="polite"></pre>
</div>
