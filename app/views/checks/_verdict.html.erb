<%# For what only a person can judge. %>
<span class="check-verdict">
  <button class="btn btn-sm btn-success" data-action="checks#saw" data-check-id="<%= id %>" data-saw="yes">I saw it</button>
  <button class="btn btn-sm btn-danger" data-action="checks#saw" data-check-id="<%= id %>" data-saw="no">I did not</button>
</span>
